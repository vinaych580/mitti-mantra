# Copy this file to .env and fill in your keys.
# Only DATAGOV_API_KEY is required. Weather and soil APIs need no key.

# data.gov.in API key — register free at https://data.gov.in/user/register
DATAGOV_API_KEY=your_api_key_here

# Optional: IndianAPI weather key (https://indianapi.in/weather-api).
# Used only as a fallback temperature source in
# data_ingestion/fetchers/indianapi_weather.py (dev/offline scripts only,
# not wired into the live app). Leave unset to skip this fallback tier.
# INDIANAPI_KEY=your_indianapi_key_here

# Optional comma-separated origins for a separately hosted frontend. Local
# origins are allowed by default; same-origin deployments do not need this.
# CORS_ORIGINS=https://app.example.com

# Offline model retraining is disabled by default. If you deliberately enable
# it, use a long random value and call the endpoint with X-Admin-Key.
# ENABLE_MODEL_TRAINING=true
# ADMIN_API_KEY=replace_with_a_long_random_secret
