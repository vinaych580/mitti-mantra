# Copy this file to .env and fill in your keys.
# Only DATAGOV_API_KEY is required. Weather and soil APIs need no key.

# data.gov.in API key — register free at https://data.gov.in/user/register
DATAGOV_API_KEY=your_api_key_here

# Google Gemini API key — register free at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
