{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "dataset/*.csv",
        "backend/**/*.py",
        "backend/*.json",
        "engine/**/*.py",
        "utils/**/*.py",
        "ml/**/*.py",
        "ml/models/*.joblib",
        "data_ingestion/**/*.py"
      ],
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/gyan-seva",
      "destination": "/frontend/gyan-seva.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
