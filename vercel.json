{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "dataset/*.csv",
          "backend/**/*.py",
          "backend/*.json",
          "engine/**/*.py",
          "utils/**/*.py",
          "ml/**/*.py",
          "ml/models/*.joblib",
          "data_ingestion/**/*.py"
        ]
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index.py"
    },
    {
      "src": "/gyan-seva",
      "dest": "/frontend/gyan-seva.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
