# Vercel ignore — keep the deployment bundle lean
.git
.gitignore
.vercel
.idea
.vscode
venv
venv/
.venv
.venv/
__pycache__
*.pyc
*.pyo
*.pyd
*.so
*.dll
*.log
*.err
*.zip
.DS_Store
.pytest_cache
.impeccable
.agents
.codex
.cursor
.claude

# Root files not needed
README.md

# Virtual environment / root installs
certifi/
charset_normalizer/
dotenv/
idna/
requests/
urllib3/
bin/
certifi-*.dist-info/
charset_normalizer-*.dist-info/
idna-*.dist-info/
python_dotenv-*.dist-info/
requests-*.dist-info/
urllib3-*.dist-info/
catboost_info/

# Unneeded project directories
tests/
docs/
scripts/*
# ...except the build step that fetches dataset/serving.sqlite (vercel.json buildCommand)
!scripts/fetch_serving_store.cjs

# ML bulk — training scripts & large artefacts not needed at runtime
ml/training/
ml/evaluate_models.py
ml/train_models.py
ml/audit_models.py
*.pt
ml/models/*.bin
frontend/models/disease/

# Dataset bulk (only keep the root CSVs)
dataset/plantvillage/
dataset/training/
dataset/raw/
dataset/processed/
dataset/dynamic/

# Node — vendor files are already copied into frontend/vendor/
node_modules
package.json
package-lock.json

# Phase 1 pipeline: build-time only; the app reads dataset/serving.sqlite
data/
pipelines/*
!pipelines/manifest.json

# Untracked vendored packages in the repo root (N-33); the bundle installs
# from requirements.txt, so these must never ship
requests/
certifi/
charset_normalizer/
idna/
urllib3/
dotenv/
*.dist-info/
bin/
catboost_info/
frontend.zip
*.pyd
