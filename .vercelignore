.gitignore
.vercel
.idea
.vscode
venv
venv/
.venv
.venv/
__pycache__
*.pyc
*.pyo
*.pyd
*.so
*.dll
*.log
*.err
.DS_Store
.pytest_cache

# Root files not needed
